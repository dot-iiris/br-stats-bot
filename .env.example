# Copy this file to .env and fill it in. Never share .env - it holds secrets.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Your server's ID (right-click server > Copy Server ID). Makes slash commands appear instantly.
GUILD_ID=

# Where the BR Stats website API is (local test server below)
WEBSITE_API_URL=http://localhost:9001/api
# Public site address, used for links in embeds
WEBSITE_URL=http://localhost:9000
# Must match BOT_API_KEY in the website's backend/.env
BOT_API_KEY=

# Channel IDs, comma separated. Leave LOBBY_CHANNEL_IDS empty to allow lobbies anywhere.
LOBBY_CHANNEL_IDS=
# Where "Match found" posts go (empty = same channel as the lobby)
MATCH_FEED_CHANNEL_ID=
# The match log channel. The WEBSITE posts confirmed results there (set
# DISCORD_MATCH_LOG_WEBHOOK_URL in the website's backend/.env); the bot only uses
# this ID to tell players where to look.
MATCH_HISTORY_CHANNEL_ID=
# Where /link requests are posted for admins to approve
ADMIN_CHANNEL_ID=

# Who counts as an admin (anyone with Manage Server also counts)
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=

# Admins can change the settings below (not the token, IDs above or key) with /admin settings
# and /admin maps, or on the website's Settings page; a changed value replaces the one here.
# Optional: map pools, separated by |. MAP_POOL is the default for both formats.
MAP_POOL=
MAP_POOL_2V2=
MAP_POOL_3V3=
# /join reuses the last match's settings for this many minutes, then goes back to defaults
STICKY_SETTINGS_MINUTES=30
# Close a lobby nobody has joined or left for this many minutes (0 = never)
LOBBY_TIMEOUT_MINUTES=30
# Players can join a lobby again once their result is submitted (submit), or only once it's
# been confirmed (confirmed)
REJOIN_AFTER=submit
# Role mentioned to gather players (right-click the role > Copy Role ID). Empty = off.
# A new lobby pings it when no lobby of that format has filled for LOBBY_PING_QUIET_MINUTES
# (at most one new-lobby ping per LOBBY_PING_COOLDOWN_MINUTES), and any lobby one player
# short (5/6, 3/4) pings it. The role must be mentionable by the bot.
LOBBY_PING_ROLE_ID=
LOBBY_PING_QUIET_MINUTES=30
LOBBY_PING_COOLDOWN_MINUTES=5
# After /submit or a cancel, delete the lobby / "Match found" posts from the
# matchmaking chat. true/false
CLEAN_MATCH_POST=true
# What players confirm on a screenshot result: score = just the round score (names, champions
# and stats are read in the background; anything unclear is listed for admins), full = everything
RESULT_CHECK=score
# A submitted 3v3 result is logged once this many players confirm it,
# at least RESULT_LOSER_CONFIRMATIONS of them from the losing team
RESULT_CONFIRMATIONS=4
RESULT_LOSER_CONFIRMATIONS=2
# The same for 2v2 games
RESULT_CONFIRMATIONS_2V2=3
RESULT_LOSER_CONFIRMATIONS_2V2=1
# Role given to members linked to a website player (when linked through the bot, or the first time
# they use it), taken back off if they're unlinked
# (right-click the role > Copy Role ID). Empty = off. The bot needs Manage Roles, and its own
# role must be above this one in Server Settings > Roles.
LINKED_ROLE_ID=
